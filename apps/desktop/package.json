{
  "name": "@pitanga/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "tsup",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "description": "Casca desktop (Electron) do Flor de Pitanga",
  "author": "Flor de Pitanga",
  "build": {
    "appId": "br.com.flordepitanga.app",
    "productName": "Flor de Pitanga",
    "extraMetadata": {
      "name": "flor-de-pitanga"
    },
    "npmRebuild": false,
    "electronLanguages": [
      "pt-BR"
    ],
    "directories": {
      "output": "../../release/instalador"
    },
    "files": [
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../release/Flor de Pitanga/app",
        "to": "app"
      },
      {
        "from": "../../release/Flor de Pitanga/app/node_modules",
        "to": "app/node_modules"
      },
      {
        "from": "../../release/Flor de Pitanga/runtime",
        "to": "runtime"
      },
      {
        "from": "../../release/Flor de Pitanga/suporte",
        "to": "suporte"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icone.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false,
      "shortcutName": "Flor de Pitanga",
      "uninstallDisplayName": "Flor de Pitanga ${version}",
      "artifactName": "Flor-de-Pitanga-Instalador-${version}.${ext}",
      "language": "1046"
    }
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.18.0"
  }
}

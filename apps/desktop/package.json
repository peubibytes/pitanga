{
  "name": "@pitanga/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "tsup",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "description": "Casca desktop (Electron) do Flor de Pitanga",
  "author": "Flor de Pitanga",
  "build": {
    "appId": "br.com.flordepitanga.app",
    "productName": "Flor de Pitanga",
    "directories": {
      "output": "../../release/instalador"
    },
    "files": [
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../release/Flor de Pitanga/app",
        "to": "app"
      },
      {
        "from": "../../release/Flor de Pitanga/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Flor de Pitanga"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
